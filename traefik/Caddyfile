{
    auto_https off
}

:8080 {
    handle_path /static/* {
        root * /srv/static
        header Content-Security-Policy "default-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
       file_server
    }

    handle_path /media/* {
        root * /srv/media
        file_server
    }

    respond 404
}
