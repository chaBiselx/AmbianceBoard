# Copier en backup.env (non versionne) puis : chmod 600 backup.env
# Memes variables que _procedure/BACKUP-BDD.md et _procedure/BACKUP-MEDIAFILES.md.

# Connexion (TRANSPORT = nom d'un fichier de script/lib/transports/)
TRANSPORT="ssh"
PROD_USER="<utilisateur>"
PROD_HOST="<ip-ou-domaine>"            # adresse VPN si le serveur est joint via un VPN
PROD_KEY="$HOME/.ssh/<nom_de_la_cle>"
PROD_BASE_PATH="<path_du_projet>"

# Base de donnees
DB_SERVICE="db"
DB_USER="<user_pg>"
DB_NAME="<nom_de_la_base>"
DB_EXCLUDE_TABLES=""                   # ex. "django_session django_admin_log"
LOCAL_BACKUPS="/srv/backups/ambianceboard/backups-bdd"
RETENTION_DAYS=0                       # 0 = aucune suppression automatique

# Mediafiles
PROD_MEDIA="$PROD_BASE_PATH/mediafiles"
LOCAL_MEDIA="/srv/backups/ambianceboard/mediafiles"
